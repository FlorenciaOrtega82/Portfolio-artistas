---
// src/components/BackToTop.astro
// Botón flotante que aparece después de scrollear un poco, y lleva de vuelta al inicio.
// Como esto necesita reaccionar al scroll del usuario, no alcanza con HTML/CSS:
// hace falta un poco de JavaScript del lado del cliente (el <script> de abajo).
---

<button
  id="back-to-top"
  aria-label="Volver arriba"
  class="fixed bottom-6 right-6 z-50 w-11 h-11 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] shadow-md flex items-center justify-center opacity-0 pointer-events-none translate-y-2 transition-all duration-300 hover:bg-[var(--color-accent)]"
>
  <!-- Ícono de flecha hacia arriba, dibujado a mano en SVG -->
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5" />
    <path d="M6 11l6-6 6 6" />
  </svg>
</button>

<script>
  // Esto corre en el navegador, no en el servidor (a diferencia del frontmatter de arriba).

  const button = document.getElementById('back-to-top');

  if (button) {
    // Mostramos el botón recién cuando el usuario bajó más de 400px,
    // así no aparece de entrada tapando el Hero.
    const toggleVisibility = () => {
      const shouldShow = window.scrollY > 400;

      // Estas clases controlan la animación de aparición/desaparición.
      button.classList.toggle('opacity-0', !shouldShow);
      button.classList.toggle('pointer-events-none', !shouldShow);
      button.classList.toggle('translate-y-2', !shouldShow);
    };

    // Se ejecuta cada vez que el usuario scrollea.
    window.addEventListener('scroll', toggleVisibility, { passive: true });

    // Al hacer click, scrolleamos suavemente hasta arriba de todo.
    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Chequeo inicial, por si la página carga ya scrolleada (ej: al recargar).
    toggleVisibility();
  }
</script>